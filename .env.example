EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-publishable-key

# Solo para scripts locales (scripts/setup-supabase.mjs)
SUPABASE_SERVICE_ROLE_KEY=tu-secret-key
# Para desplegar Edge Functions (scripts/deploy-privacy-function.mjs)
SUPABASE_ACCESS_TOKEN=tu-personal-access-token
DATABASE_URL=postgresql://postgres:PASSWORD@db.tu-proyecto.supabase.co:5432/postgres

# Sincronización AimHarder (scripts/fetch-aimharder-calendar.mjs)
AIMHARDER_BOX=opentowork
AIMHARDER_SESSION=PHPSESSID=...

# Sync automática domingos 22:00 (Europe/Madrid):
# - Windows: powershell -ExecutionPolicy Bypass -File scripts/register-weekly-sync-task.ps1
# - GitHub Actions: secrets DATABASE_URL, AIMHARDER_SESSION y opcional AIMHARDER_BOX

# Vídeos de ejercicios desde YouTube (scripts/sync-youtube-exercise-videos.mjs)
YOUTUBE_PRIMARY_CHANNEL_ID=UCG8mx9hKMAP1FwFmnzW5rKA
# Opcional: acelera búsquedas con cuota de Google Cloud
YOUTUBE_API_KEY=

# OpenAI: MCP en Cursor y generación de fotos de la tienda (Edge Function generate-gym-product-image).
OPENAI_API_KEY=
