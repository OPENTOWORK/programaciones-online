{
  "expo": {
    "name": "Training ProgLine",
    "slug": "programaciones-online",
    "version": "1.0.8",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "programaciones-online",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.trainingprogline.app"
    },
    "android": {
      "package": "com.trainingprogline.app",
      "versionCode": 9,
      "adaptiveIcon": {
        "backgroundColor": "#0F1419",
        "backgroundImage": "./assets/android-icon-background.png",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "lang": "es",
      "themeColor": "#0F1419",
      "description": "Entrenamientos y programaciones personalizadas de Training ProgLine.",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0F1419"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "La app necesita acceder a tus fotos para registrar tu progreso físico."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "La app necesita el micrófono para grabar notas de voz de feedback."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
