{
  "expo": {
    "name": "Training ProgLine",
    "slug": "programaciones-online",
    "version": "1.0.15",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "programaciones-online",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.trainingprogline.app",
      "buildNumber": "1",
      "icon": "./assets/ios-icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1",
              "0A2A.1",
              "3B52.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1",
              "85F4.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.trainingprogline.app",
      "versionCode": 16,
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0F1419",
        "backgroundImage": "./assets/android-icon-background.png",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "lang": "es",
      "themeColor": "#0F1419",
      "description": "Entrenamientos y programaciones personalizadas de Training ProgLine.",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-web-browser",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0F1419"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "La app necesita acceder a tus fotos para registrar tu progreso físico.",
          "cameraPermission": "La app necesita la cámara para grabar vídeos de tus ejercicios.",
          "microphonePermission": "La app necesita el micrófono para grabar el audio de tus vídeos de ejercicios."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "La app necesita el micrófono para grabar notas de voz de feedback."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "supabaseUrl": "https://nsdurlikkuoxqobabixr.supabase.co",
      "supabaseAnonKey": "sb_publishable_GZfJfr6RdAgbu9W9fy1O1Q_8DAgtf0k",
      "router": {},
      "eas": {
        "projectId": "1f83e52b-5f08-4c43-a449-f8650dbdbf1e"
      }
    },
    "owner": "trainingprogline"
  }
}
